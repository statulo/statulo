generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("STL_DB__CONNECTION")
}

model User {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  passwordHash              String                     @map("password_hash")
  securityStamp             String                     @default("default-stamp")
  email                     String                     @unique
  roles                     String[]                   @default([])
  emailVerified             Boolean                    @default(false) @map("email_verified")
  sessions                  UserSession[]
  orgMembers                OrgMember[]
  orgInvites                OrgInvite[]
  pendingEmailVerifications PendingEmailVerification[]

  @@map("user")
}

model UserSession {
  id            String   @id
  expiresAt     DateTime @map("expires_at")
  securityStamp String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@map("user_session")
}

model Organisation {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  name        String
  description String?

  members    OrgMember[]
  orgInvites OrgInvite[]
  monitors   Monitor[]

  @@map("organisation")
}

model OrgMember {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String       @map("org_id")
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String       @map("user_id")

  roles String[] @default([])

  @@map("org_member")
}

model OrgInvite {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  code      String   @unique

  email  String
  user   User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String?      @map("user_id")
  org    Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId  String       @map("org_id")

  roles String[] @default([])

  @@unique([email, orgId])
  @@map("org_invite")
}

model Monitor {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")
  type      String
  name      String?

  org   Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  orgId String       @map("org_id")

  http HttpMonitor?

  @@map("monitor")
}

model HttpMonitor {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  monitor   Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  monitorId String  @unique @map("monitor_id")

  interval           Json
  url                String
  expectedKeywords   String[] @map("expected_keywords")
  allowedStatusCodes String[] @map("allowed_status_codes")

  @@map("http_monitor")
}

model PendingEmailVerification {
  id        String   @id
  createdAt DateTime @default(now()) @map("created_at")

  code   String @unique
  email  String
  user   User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @map("user_id")

  @@map("pending_email_verification")
}
