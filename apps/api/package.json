{
  "name": "@repo/api",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/main.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "prisma": {
    "schema": "./src/modules/db/schema.prisma",
    "seed": "pnpm run build:run dev seed"
  },
  "scripts": {
    "start": "node dist/main.js",
    "build": "pnpm prisma generate && tsup && tsc --noEmit",
    "build:run": "pnpm build && pnpm start",
    "dev": "tsup --watch --onSuccess \"node dist/main.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prisma": "prisma",
    "prisma:studio": "prisma studio",
    "email:dev": "email dev --dir=src/modules/emails/templates",
    "postinstall": "prisma generate"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@types/figlet": "^1.7.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.30",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "@types/react": "^19.1.6",
    "type-fest": "^4.41.0"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "@fastify/swagger": "^9.5.1",
    "@neato/config": "^4.0.3",
    "@prisma/client": "^6.9.0",
    "@react-email/components": "^0.0.34",
    "@react-email/render": "^1.1.2",
    "argon2": "^0.43.0",
    "commander": "^14.0.0",
    "exec-sh": "^0.4.0",
    "fastify": "^5.3.3",
    "fastify-type-provider-zod": "^4.0.2",
    "figlet": "^1.8.1",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.1.5",
    "node-cron": "^4.1.0",
    "nodemailer": "^7.0.3",
    "ofetch": "^1.4.1",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.9.0",
    "react": "^19.1.0",
    "react-email": "^4.0.16",
    "typeid-js": "^1.2.0",
    "zod": "^3.25.56"
  }
}