---
import { getOrganisationMeta } from "@/api/organisation";
import { getStatusPageStatus } from "@/api/status-page";

const { id } = Astro.params;

if (!id) {
  throw new Error("Status page ID is required");
}

const statusPage = await getStatusPageStatus(id);
const organisation = await getOrganisationMeta(statusPage.orgId);
---

<div>
  <pre>
    {JSON.stringify(statusPage, null, 2)}
  </pre>
  <div class="container">
    <div id="hero">
      <h1>{ statusPage.name }</h1>
      <h2>{ organisation.name }</h2>
    </div>
  </div>
</div>
